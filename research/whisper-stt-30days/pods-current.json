                        "args": [
                            "set -e\nVENV=\"/root/faster-whisper-server/.venv\"\nHF_CACHE=\"/root/.cache/huggingface/hub\"\n\nmkdir -p \"$HF_CACHE\"\n\nDEEPDML_DIR=\"$HF_CACHE/models--deepdml--faster-whisper-large-v3-turbo-ct2\"\nif [ -d \"$DEEPDML_DIR/snapshots\" ]; then\n  echo \"Model already cached, skipping download\"\nelse\n  echo \"Downloading deepdml/faster-whisper-large-v3-turbo-ct2...\"\n  \"$VENV/bin/python\" -c \"\nfrom huggingface_hub import snapshot_download\nresult = snapshot_download(\n    repo_id='deepdml/faster-whisper-large-v3-turbo-ct2',\n    cache_dir='$HF_CACHE',\n)\nprint('Downloaded to:', result)\n\"\nfi\n\n# Systran/faster-whisper-large-v3-turbo is gated. Symlink so offline\n# cache lookup for \"large-v3-turbo\" resolves to the deepdml model.\nSYSTRAN_DIR=\"$HF_CACHE/models--Systran--faster-whisper-large-v3-turbo\"\nif [ ! -e \"$SYSTRAN_DIR\" ]; then\n  ln -s \"models--deepdml--faster-whisper-large-v3-turbo-ct2\" \"$SYSTRAN_DIR\"\n  echo \"Created symlink Systran -\u003e deepdml\"\nelse\n  echo \"Systran symlink already present\"\nfi\n\n# Write launcher script via base64 to avoid YAML indentation issues.\n# Script patches _MODELS to accept \"large-v3-turbo\" (older faster-whisper\n# doesn't know this size; _MODELS is a tuple so we use concatenation).\necho '' | base64 -d \u003e /root/.cache/huggingface/launch.py\necho \"launch.py written\"\necho \"Init complete\"\n"
