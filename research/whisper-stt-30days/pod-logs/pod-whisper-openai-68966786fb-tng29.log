                  pod-template-hash=68966786fb
Annotations:      <none>
Status:           Pending
IP:               
IPs:              <none>
Controlled By:    ReplicaSet/whisper-openai-68966786fb
Init Containers:
  model-download:
    Image:      fedirz/faster-whisper-server:latest-cpu
    Port:       <none>
    Host Port:  <none>
    Command:
      /bin/sh
      -c
    Args:
      set -e
      VENV="/root/faster-whisper-server/.venv"
      HF_CACHE="/root/.cache/huggingface/hub"
      
      mkdir -p "$HF_CACHE"
      
      DEEPDML_DIR="$HF_CACHE/models--deepdml--faster-whisper-large-v3-turbo-ct2"
      if [ -d "$DEEPDML_DIR/snapshots" ]; then
        echo "Model already cached, skipping download"
      else
        echo "Downloading deepdml/faster-whisper-large-v3-turbo-ct2..."
        "$VENV/bin/python" -c "
      from huggingface_hub import snapshot_download
      result = snapshot_download(
          repo_id='deepdml/faster-whisper-large-v3-turbo-ct2',
          cache_dir='$HF_CACHE',
      )
      print('Downloaded to:', result)
      "
      fi
      
      # Systran/faster-whisper-large-v3-turbo is gated. Symlink so offline
      # cache lookup for "large-v3-turbo" resolves to the deepdml model.
      SYSTRAN_DIR="$HF_CACHE/models--Systran--faster-whisper-large-v3-turbo"
      if [ ! -e "$SYSTRAN_DIR" ]; then
        ln -s "models--deepdml--faster-whisper-large-v3-turbo-ct2" "$SYSTRAN_DIR"
        echo "Created symlink Systran -> deepdml"
      else
        echo "Systran symlink already present"
      fi
      
      # Write launcher script via base64 to avoid YAML indentation issues.
      # Script patches _MODELS to accept "large-v3-turbo" (older faster-whisper
      # doesn't know this size; _MODELS is a tuple so we use concatenation).
      echo '' | base64 -d > /root/.cache/huggingface/launch.py
      echo "launch.py written"
      echo "Init complete"
      
    Limits:
      cpu:     2
      memory:  2Gi
    Requests:
      cpu:        500m
      memory:     512Mi
    Environment:  <none>
    Mounts:
      /root/.cache/huggingface from model-cache (rw)
      /var/run/secrets/kubernetes.io/serviceaccount from kube-api-access-zw4j6 (ro)
Containers:
  whisper-openai:
    Image:      fedirz/faster-whisper-server:latest-cpu
    Port:       8000/TCP
    Host Port:  0/TCP
    Command:
      /root/faster-whisper-server/.venv/bin/python
      /root/.cache/huggingface/launch.py
    Limits:
      cpu:     8
      memory:  8Gi
    Requests:
      cpu:      1
      memory:   4Gi
    Liveness:   http-get http://:8000/health delay=0s timeout=1s period=30s #success=1 #failure=5
    Readiness:  http-get http://:8000/health delay=0s timeout=1s period=10s #success=1 #failure=3
    Startup:    http-get http://:8000/health delay=10s timeout=1s period=10s #success=1 #failure=30
    Environment:
      WHISPER__MODEL:             large-v3-turbo
      WHISPER__INFERENCE_DEVICE:  cpu
      HF_HOME:                    /root/.cache/huggingface
      HF_HUB_OFFLINE:             1
    Mounts:
      /root/.cache/huggingface from model-cache (rw)
      /var/run/secrets/kubernetes.io/serviceaccount from kube-api-access-zw4j6 (ro)
Conditions:
