[Unit]
Description=Aide-de-Camp Voice/Text to Agent Server
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory=/home/coding/aide-de-camp
# Runtime secret delivery: the process fetches its own OpenBao secrets at
# start. ExecStartPre pipes the Telegram bot token into a mode-600 file in
# the unit's private runtime directory (created below, mode 700, removed on
# stop); the server reads it via TELEGRAM_BOT_TOKEN_FILE. No agent or human
# needs read access to the secret path — that dependency was the blocker
# shape that stalled the credential-provisioning beads. A failed fetch is
# non-fatal: the server starts and reports Telegram disabled at
# /api/v1/status/telegram.
RuntimeDirectory=aide-de-camp
ExecStartPre=/home/coding/aide-de-camp/deploy/fetch_runtime_secrets.sh
ExecStart=/home/coding/aide-de-camp/.venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=append:/tmp/adc.log
StandardError=append:/tmp/adc.log
Environment=PATH=/home/coding/.local/bin:/usr/bin:/bin
Environment=HOME=/home/coding
# Mode-600 file ExecStartPre delivers the bot token into; read at startup.
Environment=TELEGRAM_BOT_TOKEN_FILE=%t/aide-de-camp/telegram_bot_token
# OpenBao configuration for the dormant direct-read fallback (hvac). Only
# used when TELEGRAM_BOT_TOKEN_FILE is absent AND an OPENBAO_TOKEN has been
# provisioned into this untracked, mode-600 file via AppRole.
EnvironmentFile=-/home/coding/.config/aide-de-camp/openbao.env
# openbao-v2's public hostname is forward-auth-gated for humans; API traffic
# goes through the openbao-v2-vpn-relay user service on loopback.
Environment=OPENBAO_URL=http://127.0.0.1:18200
# Telegram bot token storage path in OpenBao — consumed by
# fetch_runtime_secrets.sh (primary) and the hvac fallback (dormant).
Environment=TELEGRAM_BOT_TOKEN_PATH=secret/ardenone-cluster/aide-de-camp/telegram_bot_token
# Telegram bot name (for identification/logging purposes)
Environment=TELEGRAM_BOT_NAME=aide_de_camp_bot
# Telegram chat ID for fallback notifications - REQUIRED
# ⚠️ MUST BE SET: See TELEGRAM_PROVISIONING.md for setup instructions
# Obtain via: Start conversation with bot, then call getUpdates API
# Environment=ADC_TELEGRAM_CHAT_ID=<your-telegram-chat-id>
# Optional: Failure log interval (default: 300 seconds)
# Environment=ADC_TELEGRAM_FAILURE_LOG_INTERVAL_SECONDS=300

[Install]
WantedBy=default.target
