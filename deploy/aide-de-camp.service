[Unit]
Description=Aide-de-Camp Voice/Text to Agent Server
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory=/home/coding/aide-de-camp
ExecStart=/home/coding/aide-de-camp/.venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=append:/tmp/adc.log
StandardError=append:/tmp/adc.log
Environment=PATH=/home/coding/.local/bin:/usr/bin:/bin
Environment=HOME=/home/coding
# OpenBao configuration for secret retrieval
# Provision OPENBAO_TOKEN into this untracked, mode-600 file via AppRole.
EnvironmentFile=-/home/coding/.config/aide-de-camp/openbao.env
Environment=OPENBAO_URL=https://openbao-v2-ardenone-cluster.ardenone.com
# Telegram bot token storage path in OpenBao
# The bot token will be retrieved from OpenBao at runtime using the path below
Environment=TELEGRAM_BOT_TOKEN_PATH=secret/ardenone-cluster/aide-de-camp/telegram_bot_token
# Telegram bot name (for identification/logging purposes)
Environment=TELEGRAM_BOT_NAME=aide_de_camp_bot
# Telegram chat ID for fallback notifications - REQUIRED
# ⚠️ MUST BE SET: See TELEGRAM_PROVISIONING.md for setup instructions
# Obtain via: Start conversation with bot, then call getUpdates API
# Environment=ADC_TELEGRAM_CHAT_ID=<your-telegram-chat-id>
# Optional: Failure log interval (default: 300 seconds)
# Environment=ADC_TELEGRAM_FAILURE_LOG_INTERVAL_SECONDS=300

[Install]
WantedBy=default.target
