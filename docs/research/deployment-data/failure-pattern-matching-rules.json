      },
      "example_messages": [
        "Secret 'db-credentials' not found",
        "Required Secret missing: api-token",
        "Cannot mount Secret: resource not found"
      ],
      "common_causes": [
        "Secret not created",
        "Wrong Secret name",
        "Secret in different namespace",
        "Secret deleted"
      ],
      "resolution_hints": [
