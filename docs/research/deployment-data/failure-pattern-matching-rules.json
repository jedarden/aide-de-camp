{
  "metadata": {
    "title": "Deployment Failure Pattern Matching Rules",
    "version": "1.0.0",
    "created": "2026-08-06T21:41:03.820530",
    "purpose": "Comprehensive pattern-matching rules for identifying deployment failure types",
    "scope": "Kubernetes deployment failures, pod lifecycle issues, and dependency problems"
  },
  "pattern_hierarchy": {
    "levels": [
      {
        "level": 1,
        "name": "Critical Infrastructure",
        "description": "Failures that prevent pod startup entirely",
        "patterns": ["ImagePullBackOff", "VolumeMountFailure", "ConfigMapMissing", "SecretMissing"]
      },
      {
        "level": 2,
        "name": "Runtime Failures",
        "description": "Failures during pod execution",
        "patterns": ["CrashLoopBackOff", "OOMKilled", "RuntimeError", "UncaughtException"]
      },
      {
        "level": 3,
        "name": "Health Check Failures",
        "description": "Failures detected by probes",
        "patterns": ["ReadinessProbeFailure", "LivenessProbeFailure", "StartupProbeFailure"]
      },
      {
        "level": 4,
        "name": "Dependency Issues",
        "description": "Failures related to external services",
        "patterns": ["DependencyTimeout", "DatabaseConnectionFailure", "APIServiceUnavailable", "NetworkPolicyBlocked"]
      },
      {
        "level": 5,
        "name": "Deployment Process Issues",
        "description": "Issues with deployment orchestration",
        "patterns": ["DeploymentRollback", "ReplicaSetFailure", "ProgressDeadlineExceeded"]
      }
    ]
  },
  "pattern_matching_rules": [
    {
      "pattern_id": "ImagePullBackOff",
      "category": "Critical Infrastructure",
      "severity": "critical",
      "description": "Container image cannot be pulled from registry",
      "matching_rules": {
        "primary_indicators": [
          {
            "field": "pod.phase",
            "operator": "contains",
            "value": "Failed"
          },
          {
            "field": "pod.containerStatuses.state.waiting.reason",
            "operator": "equals",
            "value": "ImagePullBackOff"
          },
          {
            "field": "pod.containerStatuses.state.waiting.reason",
            "operator": "equals",
            "value": "ErrImagePull"
          }
        ],
        "secondary_indicators": [
          {
            "field": "events.message",
            "operator": "contains",
            "value": "Failed to pull image"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "ImagePullBackOff"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "registry"
          },
          {
            "field": "events.reason",
            "operator": "equals",
            "value": "Pulling"
          }
        ],
        "log_patterns": [
          ".*Failed to pull image.*",
          ".*ErrImagePull.*",
          ".*BackOff pulling image.*",
          ".*registry.*timeout.*",
          ".*manifest.*not found.*",
          ".*unauthorized.*",
          ".*authentication.*failed.*"
        ]
      },
      "example_messages": [
        "Failed to pull image \"ronaldraygun/service:latest\": rpc error: code = Unknown desc = Error response from daemon: pull access denied",
        "Back-off pulling image \"example.com/image:tag\"",
        "ErrImagePull: rpc error: code = NotFound desc = image repository not found",
        "ImagePullBackOff: Cannot pull image: connection timeout"
      ],
      "common_causes": [
        "Image does not exist in registry",
        "Registry authentication failure",
        "Network connectivity to registry",
        "Image tag or name typo",
        "Private registry access denied"
      ],
      "resolution_hints": [
        "Verify image exists in registry",
        "Check image pull secrets",
        "Test network connectivity to registry",
        "Validate image tag spelling"
      ]
    },
    {
      "pattern_id": "CrashLoopBackOff",
      "category": "Runtime Failures",
      "severity": "critical",
      "description": "Pod repeatedly crashes and Kubernetes gives up restarting",
      "matching_rules": {
        "primary_indicators": [
          {
            "field": "pod.status.phase",
            "operator": "equals",
            "value": "Running"
          },
          {
            "field": "pod.containerStatuses.state.waiting.reason",
            "operator": "equals",
            "value": "CrashLoopBackOff"
          },
          {
            "field": "pod.containerStatuses.restartCount",
            "operator": "greater_than",
            "value": 4
          }
        ],
        "secondary_indicators": [
          {
            "field": "pod.containerStatuses.lastState.terminated.reason",
            "operator": "equals",
            "value": "Error"
          },
          {
            "field": "pod.containerStatuses.lastState.terminated.reason",
            "operator": "equals",
            "value": "ContainerCannotRun"
          },
          {
            "field": "events.reason",
            "operator": "equals",
            "value": "BackOff"
          }
        ],
        "log_patterns": [
          ".*CrashLoopBackOff.*",
          ".*back-off restarting.*",
          ".*container.*was terminated.*",
          ".*exit code.*[1-9].*",
          ".*Error:.*",
          ".*Exception:.*",
          ".*panic:.*"
        ]
      },
      "example_messages": [
        "back-off restarting failed container",
        "Container crashed with exit code 1",
        "Pod was terminated due to excessive restarts",
        "Application error: missing required configuration"
      ],
      "common_causes": [
        "Application code errors",
        "Missing environment variables",
        "Incorrect command or arguments",
        "Missing dependencies or libraries",
        "Runtime exceptions not caught",
        "Resource constraints causing crashes"
      ],
      "resolution_hints": [
        "Check container logs for application errors",
        "Verify environment variables are set",
        "Validate command and arguments",
        "Check for missing dependencies",
        "Review application error handling"
      ]
    },
    {
      "pattern_id": "OOMKilled",
      "category": "Runtime Failures",
      "severity": "critical",
      "description": "Container killed for exceeding memory limits",
      "matching_rules": {
        "primary_indicators": [
          {
            "field": "pod.containerStatuses.lastState.terminated.reason",
            "operator": "equals",
            "value": "OOMKilled"
          },
          {
            "field": "events.reason",
            "operator": "equals",
            "value": "Killing"
          }
        ],
        "secondary_indicators": [
          {
            "field": "events.message",
            "operator": "contains",
            "value": "OOMKilled"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "exceeded memory limits"
          },
          {
            "field": "pod.containerStatuses.state.terminated.reason",
            "operator": "equals",
            "value": "OOMKilled"
          }
        ],
        "log_patterns": [
          ".*OOMKilled.*",
          ".*memory.*limit.*exceeded.*",
          ".*out of memory.*",
          ".*Memory cgroup.*",
          ".*killed.*"
        ]
      },
      "example_messages": [
        "Container was killed (exit code 137) due to OOMKilled",
        "Exceeded memory limits: current usage 512Mi, limit 256Mi",
        "Process killed due to memory exhaustion"
      ],
      "common_causes": [
        "Memory leaks in application",
        "Memory limits set too low",
        "Sudden increase in memory usage",
        "Large file processing",
        "Memory-intensive operations"
      ],
      "resolution_hints": [
        "Increase memory limits in container spec",
        "Investigate memory leaks in application",
        "Add memory monitoring and profiling",
        "Optimize memory usage"
      ]
    },
    {
      "pattern_id": "ReadinessProbeFailure",
      "category": "Health Check Failures",
      "severity": "medium",
      "description": "Readiness probe repeatedly fails, preventing pod from receiving traffic",
      "matching_rules": {
        "primary_indicators": [
          {
            "field": "pod.status.conditions[?(@.type=='Ready')].status",
            "operator": "equals",
            "value": "False"
          },
          {
            "field": "pod.containerStatuses.state.waiting.reason",
            "operator": "equals",
            "value": "RunError"
          }
        ],
        "secondary_indicators": [
          {
            "field": "events.reason",
            "operator": "equals",
            "value": "Unhealthy"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "readiness probe failed"
          }
        ],
        "log_patterns": [
          ".*readiness.*probe.*failed.*",
          ".*Readiness.*failed.*",
          ".*GET /health.*returned 400.*",
          ".*Connection refused.*",
          ".*timeout.*waiting for.*ready.*"
        ]
      },
      "example_messages": [
        "Readiness probe failed: GET http://localhost:8080/health returned 503",
        "Readiness probe failed: connection refused",
        "Container not ready after 30 seconds"
      ],
      "common_causes": [
        "Application not fully started",
        "Health endpoint returning wrong status",
        "Dependencies not ready",
        "Port not listening",
        "Startup time exceeds probe timeout"
      ],
      "resolution_hints": [
        "Increase initialDelaySeconds",
        "Increase probe timeout",
        "Check application startup time",
        "Verify health endpoint logic"
      ]
    },
    {
      "pattern_id": "LivenessProbeFailure",
      "category": "Health Check Failures",
      "severity": "high",
      "description": "Liveness probe fails, causing pod restart",
      "matching_rules": {
        "primary_indicators": [
          {
            "field": "pod.containerStatuses.lastState.terminated.reason",
            "operator": "contains",
            "value": "Error"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "liveness probe failed"
          }
        ],
        "secondary_indicators": [
          {
            "field": "events.reason",
            "operator": "equals",
            "value": "Unhealthy"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "killing container"
          }
        ],
        "log_patterns": [
          ".*liveness.*probe.*failed.*",
          ".*Liveness.*failed.*",
          ".*killing.*container.*unhealthy.*",
          ".*deadlock.*detected.*",
          ".*application.*hung.*"
        ]
      },
      "example_messages": [
        "Liveness probe failed: killing container",
        "Container restarted due to failed liveness probe",
        "Application hung, liveness probe timeout"
      ],
      "common_causes": [
        "Application deadlock",
        "Application hung state",
        "Liveness endpoint too strict",
        "Long-running operations blocking probe",
        "Infinite loops or blocking calls"
      ],
      "resolution_hints": [
        "Check for deadlocks in application",
        "Increase liveness probe period",
        "Review liveness endpoint logic",
        "Add timeout to long operations"
      ]
    },
    {
      "pattern_id": "StartupProbeFailure",
      "category": "Health Check Failures",
      "severity": "high",
      "description": "Startup probe fails during container initialization",
      "matching_rules": {
        "primary_indicators": [
          {
            "field": "pod.containerStatuses.lastState.terminated.reason",
            "operator": "contains",
            "value": "Error"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "startup probe failed"
          }
        ],
        "secondary_indicators": [
          {
            "field": "events.reason",
            "operator": "equals",
            "value": "Failed"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "failed startup probe"
          }
        ],
        "log_patterns": [
          ".*startup.*probe.*failed.*",
          ".*Startup.*failed.*",
          ".*container.*did not start.*",
          ".*initialization.*timeout.*"
        ]
      },
      "example_messages": [
        "Startup probe failed: container did not start within timeout",
        "Failed startup probe: application not responding",
        "Container initialization exceeded deadline"
      ],
      "common_causes": [
        "Application startup time too long",
        "Missing dependencies blocking startup",
        "Configuration errors preventing startup",
        "Initialization failures"
      ],
      "resolution_hints": [
        "Increase startup probe timeout and period",
        "Check application startup logs",
        "Verify startup dependencies",
        "Review initialization code"
      ]
    },
    {
      "pattern_id": "DependencyTimeout",
      "category": "Dependency Issues",
      "severity": "high",
      "description": "Application cannot connect to required external services",
      "matching_rules": {
        "primary_indicators": [
          {
            "field": "pod.containerStatuses.state.waiting.reason",
            "operator": "contains",
            "value": "RunError"
          }
        ],
        "secondary_indicators": [
          {
            "field": "events.message",
            "operator": "contains",
            "value": "timeout"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "connection refused"
          }
        ],
        "log_patterns": [
          ".*timeout.*connecting to.*",
          ".*connection.*refused.*",
          ".*service.*unavailable.*",
          ".*database.*connection.*failed.*",
          ".*upstream.*timeout.*",
          ".*DNS.*lookup.*failed.*",
          ".*network.*unreachable.*"
        ]
      },
      "example_messages": [
        "Timeout connecting to database: postgresql.default.svc.cluster.local:5432",
        "Connection refused: API service not available",
        "Service unavailable: dependency timeout after 30s",
        "Failed to resolve DNS: api-service.example.com"
      ],
      "common_causes": [
        "Dependency service not ready",
        "Network policies blocking connections",
        "DNS resolution failures",
        "Service discovery issues",
        "Network connectivity problems"
      ],
      "resolution_hints": [
        "Check dependency service is running",
        "Verify network policies allow traffic",
        "Test DNS resolution",
        "Check service endpoints",
        "Review connection timeouts"
      ]
    },
