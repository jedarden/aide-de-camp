  ],
  "pattern_matching_algorithm": {
    "approach": "hierarchical_matching",
    "steps": [
      {
        "step": 1,
        "action": "Check for infrastructure failures (level 1)",
        "priority": "highest",
        "patterns": ["ImagePullBackOff", "VolumeMountFailure", "ConfigMapMissing", "SecretMissing"]
      },
      {
        "step": 2,
        "action": "Check for runtime failures (level 2)",
        "priority": "high",
        "patterns": ["CrashLoopBackOff", "OOMKilled"]
      },
      {
        "step": 3,
        "action": "Check for health check failures (level 3)",
        "priority": "medium",
        "patterns": ["StartupProbeFailure", "ReadinessProbeFailure", "LivenessProbeFailure"]
      },
      {
        "step": 4,
        "action": "Check for dependency issues (level 4)",
        "priority": "medium",
        "patterns": ["DependencyTimeout", "DatabaseConnectionFailure", "NetworkPolicyBlocked"]
      },
      {
        "step": 5,
        "action": "Check for deployment process issues (level 5)",
        "priority": "low",
        "patterns": ["DeploymentRollback", "ProgressDeadlineExceeded"]
      }
    ],
    "scoring": {
      "primary_match": 10,
      "secondary_match": 5,
      "log_match": 3,
      "threshold": 8
    },
    "tie_breaking": "most_specific_match_wins"
  },
  "usage_instructions": {
    "input_requirements": [
      "Pod status including phase and conditions",
      "Container statuses with state and reason",
      "Kubernetes events from the pod",
      "Container logs if available",
      "Deployment status for deployment-level issues"
    ],
    "matching_process": [
      "1. Extract relevant fields from input data",
      "2. For each pattern, evaluate matching rules in order",
      "3. Calculate pattern score based on matches",
      "4. Return patterns scoring above threshold",
      "5. Apply hierarchical tie-breaking"
    ],
    "output_format": {
      "pattern_id": "string",
      "confidence_score": "number",
      "matched_indicators": "array",
      "example_message": "string",
      "suggested_investigation": "array"
    }
  }
}