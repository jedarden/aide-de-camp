        "Validate database credentials",
        "Test network connectivity to database"
      ]
    },
    {
      "pattern_id": "DeploymentRollback",
      "category": "Deployment Process Issues",
      "severity": "medium",
      "description": "Deployment was rolled back to previous version",
      "matching_rules": {
        "primary_indicators": [
          {
            "field": "deployment.status",
            "operator": "contains",
            "value": "rolledback"
          },
          {
            "field": "events.reason",
            "operator": "equals",
            "value": "Rollback"
          }
        ],
        "secondary_indicators": [
          {
            "field": "events.message",
            "operator": "contains",
            "value": "rolled back"
          },
          {
            "field": "deployment.conditions",
            "operator": "contains",
            "value": "Progressing-False"
          }
        ],
        "log_patterns": [
          ".*rolled back to.*",
          ".*deployment.*rollback.*",
          ".*revert to.*version.*",
          ".*previous.*version.*deployed.*",
          ".*deployment.*failed.*rolling.*back.*"
        ]
      },
      "example_messages": [
        "Deployment rolled back to revision 11",
        "Rolled back to previous version due to failed health checks",
        "Deployment failure - reverted to stable version",
        "Automatic rollback triggered by failed readiness probe"
      ],
      "common_causes": [
        "Health check failures",
        "Configuration errors",
        "Performance degradation",
        "Critical bugs detected",
        "Manual rollback decision"
      ],
      "resolution_hints": [
        "Review deployment logs for root cause",
        "Fix issues in failed version",
        "Test before redeploying",
        "Consider gradual rollout strategies"
      ]
    },
    {
      "pattern_id": "VolumeMountFailure",
      "category": "Critical Infrastructure",
      "severity": "critical",
      "description": "Cannot mount required volume",
      "matching_rules": {
        "primary_indicators": [
          {
            "field": "pod.containerStatuses.state.waiting.reason",
            "operator": "contains",
            "value": "ContainerCreating"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "volume"
          }
        ],
        "secondary_indicators": [
          {
            "field": "events.reason",
            "operator": "equals",
            "value": "Failed"
          },
          {
            "field": "events.message",
            "operator": "contains",
            "value": "mount"
          }
        ],
        "log_patterns": [
          ".*volume.*mount.*failed.*",
          ".*persistentvolume.*not found.*",
          ".*persistentvolumeclaim.*not found.*",
          ".*cannot.*mount.*volume.*",
