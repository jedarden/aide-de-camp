        "Cannot mount volume: PVC does not exist",
        "Failed to attach volume: timeout",
        "Volume 'config-volume' not found"
      ],
      "common_causes": [
        "PVC not created",
        "PV not available",
        "Storage class issues",
        "Volume attachment failures",
        "Wrong volume name in spec"
      ],
      "resolution_hints": [
        "Create missing PVC",
        "Verify storage class exists",
        "Check volume availability",
        "Validate volume configuration"
      ]
    },
