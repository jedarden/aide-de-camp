  "definitions": {
    "thirtyDayCompleteness": {
      "type": "object",
      "description": "30-day data completeness validation requirements. This definition ensures deployment data covers a continuous 30-day period without significant gaps.",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "time_period": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": true
            }
          },
          "required": ["time_period"],
          "additionalProperties": true
        },
        "deployment_events_last_30_days": {
          "type": "array",
          "description": "Must contain at least one deployment event to verify 30-day coverage",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["date", "timestamp"],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": true
          }
        },
        "deployment_metrics": {
          "type": "object",
          "required": ["total_deployments_last_30_days"],
          "properties": {
            "total_deployments_last_30_days": {
              "type": "integer",
              "minimum": 0,
              "description": "Must be non-negative; zero indicates no deployments in period"
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["metadata", "deployment_events_last_30_days", "deployment_metrics"]
    }
  }
